# ──────────────────────────────────────────────────────────────
# Local development environment variables
# Copy this file to .env if needed; it is loaded automatically
# by `make up` / `make local-back`.
# ──────────────────────────────────────────────────────────────

# DynamoDB local endpoint (docker-compose)
DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# Fake credentials required by the AWS SDK even for DynamoDB Local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# JWT — change in production
JWT_SECRET=local-dev-secret-do-not-use-in-production

# CORS — must match the frontend origin
ALLOWED_ORIGINS=http://localhost:3000

# App environment
ENV=development

# Table names (must match infra/scripts/create-tables.sh)
TABLE_USERS=sf_users
TABLE_SIMULATIONS=sf_simulations
TABLE_QUESTIONS=sf_questions
TABLE_USER_SIMS=sf_user_simulations
TABLE_ATTEMPTS=sf_attempts
